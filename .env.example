# =====================================================================
# PayPilot AI: Environment Configuration Template
# Duplicate this file to '.env' and populate with your sandbox credentials
# =====================================================================

# PayPal Developer Sandbox Credentials (Obtain from https://developer.paypal.com)
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# PayPal Webhook Security
# Obtain WEBHOOK_ID from your PayPal Developer App dashboard after registering your webhook URL
PAYPAL_WEBHOOK_ID=your_sandbox_webhook_id_here

# LLM Provider Configuration (OpenAI, Gemini, or Anthropic)
OPENAI_API_KEY=your_openai_or_compatible_api_key_here
LLM_MODEL=gpt-4o-mini

# Application Settings
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./data/processed/paypilot.db

# Risk & Financial Safety Circuit Breakers
MAX_SINGLE_PAYOUT_LIMIT=1000.00
MAX_BATCH_TOTAL_LIMIT=5000.00
AUTO_APPROVAL_RISK_THRESHOLD=0.30
