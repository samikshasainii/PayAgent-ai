# =====================================================================
# PayAgent AI: Environment Configuration Template
# Copy to '.env' and fill in your sandbox credentials.
# =====================================================================

# PayPal Developer Sandbox Credentials (https://developer.paypal.com)
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Set true to run tests/smoke runs without PayPal keys (console shows a MOCK MODE banner)
MOCK_PAYPAL=false

# PayPal Webhooks (register your public URL first, then paste the webhook ID)
# Leave blank for local runs; the reconciliation poller tracks payout status instead.
PAYPAL_WEBHOOK_ID=

# Demo seed data: email of your sandbox PERSONAL account (the payout recipient)
SANDBOX_RECIPIENT_EMAIL=sb-xxxxx@personal.example.com

# LLM (Proof-of-Task review) — Gemini via its OpenAI-compatible endpoint (free tier: aistudio.google.com/apikey)
# To use OpenAI instead: set OPENAI_API_KEY, LLM_BASE_URL=https://api.openai.com/v1, LLM_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=10

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./data/processed/payagent.db
# Operator (dashboard / task admin) token - demo-grade auth
OPERATOR_TOKEN=change-me-demo-operator-token
# Enables /api/v1/webhooks/simulate (ignored when APP_ENV=production)
DEMO_MODE=true

# Guardian policy (see ARCHITECTURE.md section 5.1)
MAX_SINGLE_TASK_AUTO_APPROVE=50.00
MIN_LLM_CONFIDENCE=0.75
MAX_AGENT_HOURLY_VELOCITY=200.00
CIRCUIT_BREAKER_INCIDENTS=3
CIRCUIT_BREAKER_WINDOW_MINUTES=10
