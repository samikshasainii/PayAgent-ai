            "body": {
              "mode": "raw",
              "raw": "{\n  \"task_id\": \"{{happy_task_id}}\",\n  \"amount\": 25.00,\n  \"deliverables\": {\n    \"review_summary\": \"{{happy_review_summary}}\",\n    \"security_checklist\": \"{{happy_security_checklist}}\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/payout-requests",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "payout-requests"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var ts = pm.environment.get('current_timestamp') || Date.now().toString();",
                  "var revSummary = 'Completed security audit for PR #42 at timestamp ' + ts;",
                  "var secList = 'OWASP Top 10 checklist verified clean at timestamp ' + ts;",
                  "pm.environment.set('happy_review_summary', revSummary);",
                  "pm.environment.set('happy_security_checklist', secList);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 202 Accepted', function () {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Status is RECEIVED', function () {",
                  "    pm.expect(json.status).to.eql('RECEIVED');",
                  "});",
                  "pm.environment.set('happy_payout_id', json.payout_request_id);",
                  "pm.environment.set('happy_poll_count', '0');"
                ]
              }
            }
          ]
        },
        {
          "name": "Poll Happy Path Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{agent_code_reviewer_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/payout-requests/{{happy_payout_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "payout-requests",
                "{{happy_payout_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "var pollCount = parseInt(pm.environment.get('happy_poll_count') || '0', 10);",
                  "var maxRetries = 15;",
                  "",
                  "if (json.status !== 'PAID' && pollCount < maxRetries) {",
                  "    pm.environment.set('happy_poll_count', (pollCount + 1).toString());",
                  "    setTimeout(function () {",
                  "        pm.execution.setNextRequest('Poll Happy Path Status');",
                  "    }, 500);",
                  "} else {",
                  "    pm.execution.setNextRequest('Submit Over Budget Payout');",
                  "    pm.test('Final status reached PAID', function () {",
                  "        pm.expect(json.status).to.eql('PAID');",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
